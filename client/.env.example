# Client Environment Variables

# API Base URL (your backend server)
# Development: http://localhost:4000/api
# Production: https://your-server.railway.app/api or https://your-server.vercel.app/api
VITE_API_URL=http://localhost:4000/api

# Socket.IO Server URL (your backend server)
# Development: http://localhost:4000
# Production: https://your-server.railway.app or https://your-server.vercel.app
VITE_SOCKET_URL=http://localhost:4000
