# Server port (Render uses PORT, locally you can use SERVER_PORT)
# Production: PORT is set by hosting platform (e.g., Render sets PORT=10000)
# Development: Use SERVER_PORT for local development
SERVER_PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# For local development use localhost
# MONGODB_URI=mongodb://localhost:27017/readtogether

# For production use MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/readtogether?retryWrites=true&w=majority&appName=Cluster0

JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars-long

STORAGE_TYPE=local
UPLOAD_DIR=./uploads
